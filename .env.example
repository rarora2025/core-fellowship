# All optional.

# LinkedIn lookup in the student application reads DuckDuckGo results by
# default (no key). Set a Brave Search API key to use that instead, or
# LINKEDIN_SEARCH=off to turn the lookup off.
BRAVE_SEARCH_API_KEY=
LINKEDIN_SEARCH=

# Supabase (Project Settings → API). Server-only: never expose these in the browser.
# Leave empty to save to local files in ./.submissions (fine on localhost only).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Site address, once the domain is live (e.g. https://fellowship.example.org).
NEXT_PUBLIC_SITE_URL=

# Email (calendar invites), through Resend: https://resend.com
# MAIL_FROM must be on a domain verified in Resend, e.g. "CORE Fellowship <noreply@yourdomain>".
RESEND_API_KEY=
MAIL_FROM=

# Password for /board, the page for the people running interviews.
BOARD_PASSWORD=
